# Copy this file to .env for local dev. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Neon pooled connection string (host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Upstash Redis. Leave commented out locally to use the in-memory channel layer.
# REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# Optional: Cloudflare Turnstile bot protection on signup (free).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
